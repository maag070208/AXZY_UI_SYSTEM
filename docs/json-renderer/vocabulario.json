      "type": "ITAlert",
      "summary": "Aviso con variante semántica.",
      "children": true,
      "text": true,
      "props": [
        {
          "name": "variant",
          "kind": "enum",
          "required": false,
          "values": [
            "info",
            "success",
            "warning",
            "error"
          ],
          "default": "info"
        },
        {
          "name": "title",
          "kind": "string",
          "required": false
        },
        {
          "name": "dismissible",
          "kind": "boolean",
          "required": false,
          "default": false
        },
        {
          "name": "onDismiss",
          "kind": "action",
          "required": false
        },
        {
          "name": "className",
          "kind": "string",
          "required": false,
          "doc": "Clases extra del componente."
        }
      ],
      "forbidden": [
        "icon"
      ],
      "minimal": {
        "type": "ITAlert",
        "text": "Texto"
      }
    },
