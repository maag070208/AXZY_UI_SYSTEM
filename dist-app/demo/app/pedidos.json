{
  "$schema": "axzy/screen",
  "version": 1,
  "id": "demo.pedidos",
  "data": {
    "pedidos": {
      "handler": "pedidos"
    }
  },
  "content": [
    {
      "type": "ITStack",
      "props": {
        "direction": "column",
        "spacing": 8,
        "alignItems": "stretch"
      },
      "children": [
        {
          "type": "ITFlex",
          "props": {
            "wrap": "wrap",
            "gap": 2
          },
          "children": [
            {
              "type": "ITButton",
              "props": {
                "label": {
                  "i18n": "sandbox.app.pedidos.new"
                },
                "size": "md",
                "onClick": {
                  "action": "nuevo-registro",
                  "args": {
                    "tipo": "pedido"
                  }
                }
              }
            },
            {
              "type": "ITButton",
              "props": {
                "label": {
                  "i18n": "sandbox.app.back"
                },
                "size": "md",
                "onClick": {
                  "action": "ir-pagina",
                  "args": {
                    "pagina": "inicio"
                  }
                },
                "variant": "text",
                "color": "gray"
              }
            }
          ]
        },
        {
          "type": "ITGrid",
          "props": {
            "container": true,
            "spacing": 4
          },
          "children": [
            {
              "type": "ITGrid",
              "props": {
                "item": true,
                "xs": 6,
                "md": 3
              },
              "children": [
                {
                  "type": "ITStatCard",
                  "props": {
                    "label": {
                      "i18n": "sandbox.app.statOrders"
                    },
                    "value": "42"
                  }
                }
              ]
            },
            {
              "type": "ITGrid",
              "props": {
                "item": true,
                "xs": 6,
                "md": 3
              },
              "children": [
                {
                  "type": "ITStatCard",
                  "props": {
                    "label": {
                      "i18n": "sandbox.app.pedidos.paid"
                    },
                    "value": "11"
                  }
                }
              ]
            },
            {
              "type": "ITGrid",
              "props": {
                "item": true,
                "xs": 6,
                "md": 3
              },
              "children": [
                {
                  "type": "ITStatCard",
                  "props": {
                    "label": {
                      "i18n": "sandbox.app.pedidos.pending"
                    },
                    "value": "11"
                  }
                }
              ]
            },
            {
              "type": "ITGrid",
              "props": {
                "item": true,
                "xs": 6,
                "md": 3
              },
              "children": [
                {
                  "type": "ITStatCard",
                  "props": {
                    "label": {
                      "i18n": "sandbox.app.pedidos.cancelled"
                    },
                    "value": "10"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "ITDivider",
          "props": {
            "orientation": "horizontal"
          }
        },
        {
          "type": "ITDataTable",
          "props": {
            "columns": [
              {
                "key": "folio",
                "label": "Folio",
                "type": "string",
                "sortable": true,
                "filter": true
              },
              {
                "key": "cliente",
                "label": "Cliente",
                "type": "string",
                "filter": "catalog"
              },
              {
                "key": "total",
                "label": "Total",
                "type": "number",
                "sortable": true,
                "currencyMX": true
              },
              {
                "key": "estado",
                "label": "Estado",
                "type": "string",
                "filter": "catalog"
              },
              {
                "key": "fecha",
                "label": "Fecha",
                "type": "date",
                "sortable": true
              }
            ],
            "fetchData": {
              "$source": "pedidos"
            },
            "defaultItemsPerPage": 10,
            "itemsPerPageOptions": [
              5,
              10,
              20
            ],
            "density": "normal",
            "variant": "striped",
            "layout": "fixed"
          }
        }
      ]
    }
  ],
  "title": {
    "i18n": "sandbox.app.pedidos.title"
  },
  "description": {
    "i18n": "sandbox.app.pedidos.lead"
  }
}
