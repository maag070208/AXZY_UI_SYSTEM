{
  "name": "@axzydev/axzy_ui_system",
  "author": "axzydev <aamaro@axzy.dev>",
  "packageManager": "pnpm@10.34.0",
  "private": false,
  "license": "MIT",
  "version": "1.8.6",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dist/index.css": "./dist/index.css",
    "./layered.css": "./dist/layered.css",
    "./style": "./dist/index.css"
  },
  "files": [
    "dist",
    "src",
    "snippets"
  ],
  "scripts": {
    "dev": "vite",
    "build": "pnpm bundle",
    "build:app": "tsc -b && vite build -c vite.app.config.ts",
    "build:css": "node scripts/build-css.mjs",
    "lint": "eslint . && node scripts/check-atomic-deps.mjs && node scripts/check-css-isolation.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:atomic": "node scripts/check-atomic-deps.mjs",
    "check:css": "node scripts/check-css-isolation.mjs",
    "preview": "vite preview",
    "bundle": "tsup src/index.ts && node scripts/build-css.mjs",
    "watch": "tsup src/index.ts --watch",
    "ext:catalog": "node vscode-extension/scripts/generate-catalog.mjs",
    "ext:build": "node vscode-extension/esbuild.mjs",
    "ext:typecheck": "tsc --noEmit -p vscode-extension/tsconfig.json",
    "ext:package": "node vscode-extension/esbuild.mjs && cd vscode-extension && npx --yes @vscode/vsce package --no-dependencies",
    "audit:sandbox": "node scripts/audit-sandbox.mjs",
    "docs:llm": "pnpm ext:catalog && node scripts/build-llm-docs.mjs && node scripts/build-ai-bundle.mjs",
    "docs:ai": "node scripts/build-ai-bundle.mjs",
    "docs:json-renderer": "node scripts/build-json-renderer-docs.mjs",
    "schema:check": "node scripts/json-renderer/check.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "formik": "^2.4.6",
    "react-dropzone": "^14.3.8",
    "react-icons": "^5.4.0",
    "tailwind-merge": "^3.4.0",
    "yup": "^1.6.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.13.1",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@types/vscode": "1.85.0",
    "@vitejs/plugin-react-swc": "3.8.0",
    "ajv": "8.18.0",
    "esbuild": "^0.25.0",
    "eslint": "9.19.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.18",
    "globals": "15.14.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.3.6",
    "typescript": "~5.7.2",
    "typescript-eslint": "8.22.0",
    "vite": "6.1.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.2.7"
  }
}
